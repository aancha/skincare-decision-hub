  "recommendationGuardrails": {
    "shortlistPromptRules": [
      "Do not give medical diagnosis or treatment claims.",
      "If the question mentions pregnancy, trying to conceive, or breastfeeding, stay conservative and do not claim that a product is definitively pregnancy-safe.",
      "If the question mentions severe irritation, swelling, rash, open skin, infection signs, eye swelling, or post-procedure, chemotherapy, or radiation skin, redirect toward medical guidance instead of escalating product use.",
      "Reset unrealistic expectations such as overnight fixes, guarantees, or permanent pore changes."
    ],
    "questionSignals": [
      {
        "id": "pregnancy-request",
        "tag": "pregnancy-uncertain",
        "severity": "warning",
        "patterns": [
          "\\bpregnan",
          "\\btrying to conceive\\b",
          "\\bttc\\b",
          "\\bbreastfeed",
          "\\bnursing\\b",
          "\\bexpectant\\b"
        ],
        "message": "Pregnancy-related questions need a conservative read. Keep the routine simple and confirm treatment ingredients with a clinician."
      },
      {
        "id": "expectation-reset",
        "tag": "expectation-reset",
        "severity": "warning",
        "patterns": [
          "\\bovernight\\b",
          "\\bguaranteed?\\b",
          "\\binstantly?\\b",
          "\\berase\\b.*\\bwrinkle",
          "\\bremove\\b.*\\bdark spots?\\b",
          "\\bpermanent(?:ly)?\\b.*\\bpores?\\b",
          "\\b(?:1|2|3|4|5|6|7)\\s*(?:day|days|week|weeks)\\b.*\\b(?:erase|remove|clear|fix|fade)\\b",
          "\\b(?:erase|remove|clear|fix|fade)\\b.*\\b(?:1|2|3|4|5|6|7)\\s*(?:day|days|week|weeks)\\b"
        ],
        "message": "That result window is not realistic for skincare. Favor a steady routine and judge progress over weeks, not overnight."
      },
      {
        "id": "red-flag-medical-claim",
        "tag": "clinician-needed",
        "severity": "redirect",
        "patterns": [
          "\\bcure\\b.*\\beczema\\b",
          "\\beczema\\b.*\\bcure\\b"
        ],
        "message": "Do not treat skincare products as cures for medical skin conditions. Use clinician guidance for eczema treatment claims."
      },
      {
        "id": "red-flag-severe-reaction",
        "tag": "medical-red-flag",
        "severity": "redirect",
        "patterns": [
          "\\brash\\b",
          "\\bhives\\b",
          "\\bswelling\\b",
          "\\bsevere irritation\\b",
          "\\bsevere burning\\b",
          "\\bskin is burning\\b",
          "\\bburning\\b.*\\bafter\\b",
          "\\boozing\\b",
          "\\bweeping\\b",
          "\\bopen skin\\b",
          "\\bbleeding\\b",
          "\\bpus\\b",
          "\\binfection\\b",
          "\\binfected\\b",
          "\\bfever\\b",
          "\\beye swelling\\b"
        ],
        "message": "Those symptoms sound beyond normal product shopping guidance. Stop new actives and get medical advice."
      },
      {
        "id": "prescription-active-context",
        "tag": "prescription-active-caution",
        "severity": "warning",
        "patterns": [
          "\\bprescription\\b",
          "\\btretinoin\\b",
          "\\badapalene\\b",
          "\\bclindamycin\\b"
        ],
        "message": "Prescription active routines need a conservative read. Do not add more actives without clinician guidance."
      },
      {
        "id": "allergy-context",
        "tag": "allergy-uncertain",
        "severity": "warning",
        "patterns": [
          "\\ballerg(?:y|ies|ic)\\b",
          "\\bknown allergen\\b"
        ],
        "message": "Catalog data cannot confirm allergy safety. Check the complete ingredient list and use clinician guidance when reaction history or ingredient uncertainty is involved."
      },
      {
        "id": "red-flag-post-procedure",
        "tag": "clinician-needed",
        "severity": "redirect",
        "patterns": [
          "\\bpost-procedure\\b",
          "\\bafter laser\\b",
          "\\bafter peel\\b",
          "\\bchemo(?:therapy)?\\b",
          "\\bradiation\\b"
        ],
        "message": "Post-procedure or medically treated skin needs clinician-specific guidance before adding actives."
      },
      {
        "id": "red-flag-cystic",
        "tag": "clinician-needed",
        "severity": "redirect",
        "patterns": [
          "\\bcystic acne\\b",
          "\\bpainful nodules?\\b",
          "\\bscarring\\b.*\\bacne\\b"
        ],
        "message": "Painful or scarring acne can need clinician-level care, not just a stronger shopping recommendation."
      },
      {
        "id": "red-flag-eczema-rosacea",
        "tag": "clinician-needed",
        "severity": "redirect",
        "patterns": [
          "\\beczema flare\\b",
          "\\brosacea\\b.*\\bburning\\b",
          "\\bflushing\\b.*\\bburning\\b"
        ],
        "message": "A flare with burning, cracking, or persistent redness needs a conservative routine and medical guidance if it is active or worsening."
      }
    ],
    "ingredientGroups": {
      "retinoids": ["retinol", "retinal", "retinoid"],
